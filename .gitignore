# Compiled artifact binaries under artifacts/*/dist/ are reproducible from
# tracked source via each artifact's scripts/reproduce.sh; keep the
# repository limited to source, build scripts, and evidence/provenance
# manifests, and publish these as GitHub Release assets instead of
# committing them (see the affected artifacts' README.md).
artifacts/*/dist/**/Capsule
artifacts/*/dist/**/*Launcher
artifacts/*/dist/**/capsule-mjs-source-validator-daemon
artifacts/*/dist/**/capsule-mjs-source-validator-approval-broker
artifacts/mjs-source-validator-v1/dist/capsule-mjs-source-validator-aarch64-apple-darwin
tmp/
