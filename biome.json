{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!experiments",
      "!!artifacts/**/target",
      "!!schemas/conformance/v0/manifest.json",
      "!!schemas/conformance/v0/canonical-inline-input",
      "!!schemas/conformance/v0/contexts",
      "!!schemas/conformance/v0/job-proposal",
      "!!schemas/conformance/v0/mjs-source",
      "!!schemas/conformance/v0/mjs-source-manifest",
      "!!schemas/conformance/v0/source-manifest",
      "!!schemas/conformance/typescript-approved-byte-v0",
      "!!schemas/conformance/c2b-governed-deno-core/inputs",
      "!!schemas/conformance/macos-i2b2-unsigned-installation/profile.schema.json",
      "!!.claude/worktrees",
      "!!**/.codex/skills",
      "!!.codex/steering/javascript-esm-steering.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/**", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noShadow": "error",
            "useAwait": "error"
          },
          "style": {
            "noParameterAssign": "error"
          },
          "nursery": {
            "noFloatingPromises": "error",
            "noMisusedPromises": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
