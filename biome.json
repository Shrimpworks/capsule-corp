{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!experiments/**/build",
      "!!experiments/**/.build",
      "!!experiments/**/.runs",
      "!!experiments/**/.swiftpm",
      "!!schemas/conformance/v0/manifest.json",
      "!!**/.codex/skills",
      "!!.codex/steering/javascript-esm-steering.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
