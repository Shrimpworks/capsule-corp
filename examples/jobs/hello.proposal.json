{
  "apiVersion": "capsule.dev/v0",
  "kind": "JobProposal",
  "source": {
    "entrypoint": "main.mjs",
    "files": {
      "main.mjs": "export default function (input) { return input; }\n"
    }
  },
  "runtimeProfile": "bun-data@1",
  "input": {
    "slot": "primary-data",
    "kind": "inline-json",
    "value": {
      "message": "hello"
    }
  },
  "requestedLimits": {
    "wallTimeMs": 5000
  },
  "outputs": [
    {
      "slot": "transformed-json",
      "kind": "inline-json",
      "maxBytes": 65536
    }
  ],
  "labels": {
    "example": "hello"
  }
}
