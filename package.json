{
  "name": "capsule-corp",
  "version": "0.0.0",
  "private": true,
  "description": "Capability-controlled JS/TS task runtime for AI agents",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm build && pnpm --recursive check",
    "clean": "pnpm --recursive clean",
    "codex:links": "node scripts/setup-codex-links.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate:conformance": "node scripts/generate-contract-conformance-fixtures.mjs && node scripts/generate-typescript-approved-byte-conformance.mjs",
    "lint": "biome check .",
    "site:build": "node scripts/build-site.mjs",
    "test": "pnpm --recursive test && node --test scripts/verify-contract-conformance.test.mjs scripts/verify-field-authority-manifest.test.mjs scripts/verify-governed-deno-core-c1.test.mjs scripts/verify-mjs-source-validator-v1.test.mjs scripts/verify-source-validator-r2.test.mjs",
    "verify:adrs": "node scripts/verify-adr-index.mjs",
    "verify:schemas": "node scripts/verify-schemas.mjs && node scripts/verify-cddl-fixtures.mjs && node scripts/generate-contract-conformance-fixtures.mjs --check && node scripts/verify-contract-conformance.mjs && node scripts/generate-typescript-approved-byte-conformance.mjs --check && node scripts/verify-field-authority-manifest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.0"
  }
}
