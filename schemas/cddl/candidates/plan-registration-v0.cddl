; Capsule PlanRegistration v0 passive candidate payload.
; Evaluate with common-v0.cddl. This object is generated by the Supervisor and
; returned over authenticated typed local IPC. It contains no replacement plan
; bytes and is not independently signed portable authority.

capsule-plan-registration-v0 = {
  1: "capsule.plan-registration", ; objectType
  2: 0, ; objectVersion
  3: capsule-id-v0, ; registrationId (role: registration)
  4: capsule-positive-uint53-v0, ; registrationSequence
  5: capsule-sha256-v0, ; planDigest (role: ExecutionPlan)
  6: capsule-id-v0, ; installationId (role: installation)
  7: capsule-uint53-v0, ; trust epoch sequence
  8: capsule-sha256-v0, ; epochDigest (role: trust epoch)
  9: capsule-id-v0, ; supervisorId (role: Supervisor)
  10: capsule-unix-seconds-v0, ; expiresAt
}
