; Capsule passive I2B1 Supervisor bootstrap signed-object contracts.
;
; These are closed, zero-effect conformance objects. They do not define a
; production signer, Keychain item, IPC message, protected-root operation, or
; installed profile. Both envelopes use the ADR-0019 Sign1-only profile.

capsule-supervisor-bootstrap-request-envelope-v0 = #6.18([
  protected: bstr .cbor capsule-supervisor-bootstrap-request-protected-v0,
  unprotected: {},
  payload: bstr .cbor capsule-supervisor-bootstrap-request-v0,
  signature: bstr .size 64,
])

capsule-supervisor-bootstrap-request-protected-v0 = {
  1: -7,
  3: "application/capsule.supervisor-bootstrap-request+cbor;v=0",
  4: capsule-bootstrap-key-id,
